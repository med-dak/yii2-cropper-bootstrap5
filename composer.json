{
  "name": "jalloulkhaled/yii2-cropper-bootstrap5",
  "description": "Yii2 Bootstrap Cropper Input Widget using Bootstrap 5",
  "type": "yii2-extension",
  "keywords": ["yii2", "extension", "cropper", "widget"],
  "license": "MIT",
  "authors": [
    {
      "name": "Jalloul Khaled",
      "email": "khaled.jalloul@heretic-sas.com",
      "homepage": "https://github.com/jalloulkhaled?tab=repositories"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "yiisoft/yii2": "^22.0@dev",
    "yiisoft/yii2-bootstrap5": "^22.0@dev",
    "npm-asset/bootstrap": "^5.3",
    "npm-asset/jquery": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "jalloulkhaled\\cropper\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0.x-dev"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ]
}
